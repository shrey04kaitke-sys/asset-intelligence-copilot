# Copy to .env (git-ignored). Never commit real keys.
COPILOT_DATASET_DIR=dataset/sample-data
COPILOT_DATA_DIR=data
# Override "today" (ISO date). Default: day after the latest inspection in the data.
# COPILOT_TODAY=2026-10-16
# Model provider: gemma_api (Google AI Studio) | ollama | none
COPILOT_PROVIDER=gemma_api
# Hosted Gemma 4 ids documented for the Gemini API: gemma-4-26b-a4b-it (faster) | gemma-4-31b-it (stronger)
COPILOT_MODEL=gemma-4-26b-a4b-it
# Preferred: store the key in the Windows Credential Manager with `python scripts/setup_gemini_key.py` (hidden prompt).
# Optional fallback for the process environment (never commit a real value):
# GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
